---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ScoreBar from '../../components/ScoreBar.astro';
import OrganicBlob from '../../components/OrganicBlob.astro';
import { DIMENSIONS, QUESTIONS } from '../../data/questions';

const sections = Array.from({ length: 4 }, (_, i) => QUESTIONS.slice(i * 6, i * 6 + 6));
const preferenceEntries = Object.entries(DIMENSIONS).filter(([, v]) => v.kind === 'preference');
const stateEntries = Object.entries(DIMENSIONS).filter(([, v]) => v.kind === 'state');
---
<BaseLayout title="欲求MAPセルフチェック" description="約3分で、欲求・親密性・関係の現在地を可視化する18歳以上向けセルフチェック。">
  <section class="section check-wrap">
    <div class="container narrow">
      <div id="intro" class="card intro">
        <OrganicBlob class="intro-blob" />
        <span class="eyebrow">SOLO MAP / 18+</span>
        <h1 class="h2">欲求MAPセルフチェック</h1>
        <p class="lead">24問に直感で答えてください。正解・不正解はありません。</p>
        <div class="notice">これは医学的・心理学的診断ではなく、自己理解のためのセルフチェックです。MVPでは回答内容をサーバーに保存しません。</div>
        <button id="start" class="btn primary" type="button">チェックを始める</button>
      </div>

      <form id="check-form" hidden novalidate>
        <div class="progress" aria-label="進捗"><span id="progress-bar"></span></div>
        <p id="progress-label" class="progress-label" aria-live="polite"></p>
        {sections.map((group, sectionIndex) => (
          <fieldset class="question-section card" data-section={sectionIndex} hidden={sectionIndex !== 0}>
            <legend>Part {sectionIndex + 1}</legend>
            {group.map((q, index) => (
              <div class="question" data-question={q.id}>
                <p class="q-number">Q{sectionIndex * 6 + index + 1}</p>
                <h2>{q.text}</h2>
                <div class="scale" role="radiogroup" aria-label={q.text}>
                  {[[1,'まったく違う'],[2,'やや違う'],[3,'どちらともいえない'],[4,'やや当てはまる'],[5,'とても当てはまる']].map(([value,label]) => (
                    <label><input type="radio" name={q.id} value={String(value)} required /><span><b>{value}</b><small>{label}</small></span></label>
                  ))}
                </div>
              </div>
            ))}
            <div class="step-actions">
              <button class="btn back" type="button" data-back hidden={sectionIndex === 0}>戻る</button>
              {sectionIndex < sections.length - 1 ? <button class="btn primary next" type="button" data-next>次へ</button> : <button class="btn primary" type="submit">結果を見る</button>}
            </div>
            <p class="form-error" aria-live="polite"></p>
          </fieldset>
        ))}
      </form>

      <section id="result" class="result" hidden aria-live="polite">
        <div class="card result-hero">
          <OrganicBlob class="result-blob" flip />
          <span class="eyebrow">YOUR CURRENT MAP</span><h1 id="result-title" class="h2">あなたのMAP</h1>
          <p id="result-summary" class="lead"></p>
          <p class="muted">結果は「今の傾向」です。固定的な性格や正常・異常を判定するものではありません。</p>
          <div class="result-actions"><button id="share" class="btn primary" type="button">結果ページをシェア</button><button id="retry" class="btn" type="button">もう一度チェック</button></div>
        </div>
        <div class="result-grid">
          <div class="card"><span class="eyebrow">PREFERENCE</span><h2>欲求の傾向</h2><div class="bars">{preferenceEntries.map(([id,d]) => <ScoreBar id={id} label={d.label} kind="preference" />)}</div></div>
          <div class="card"><span class="eyebrow">NOW</span><h2>今の状態</h2><div class="bars">{stateEntries.map(([id,d]) => <ScoreBar id={id} label={d.label} kind="state" />)}</div></div>
        </div>
        <div class="card recommendation-wrap"><span class="eyebrow">NEXT ACTION</span><h2>今のあなたに合う、小さな次の一歩</h2><div id="recommendations" class="recommendations"></div></div>
        <div class="card pair-card">
          <span class="eyebrow">PAIR</span>
          <h2>パートナーと比べてみる</h2>
          <p class="muted">二人がそれぞれ欲求MAPをやって、結果を見比べる機能です。「相性の点数」は出しません。違いを、会話のきっかけとして見るためのものです。</p>
          <div class="pair-step">
            <h3>1. あなたのコードを渡す</h3>
            <output id="pair-my-code" class="pair-code" aria-label="あなたのコード"></output>
            <div class="pair-actions">
              <button id="pair-copy-code" class="btn" type="button">コードをコピー</button>
              <button id="pair-copy-invite" class="btn" type="button">招待メッセージをコピー</button>
            </div>
            <p id="pair-status" class="pair-status" aria-live="polite"></p>
            <div class="notice">コードにはあなたの8つのスコアが含まれます。相手にだけ送り、SNSなど公開の場には貼らないでください。コードはこの端末のブラウザの中だけで作られ、サーバーへの保存・送信はしません。</div>
          </div>
          <form id="pair-form" class="pair-step" novalidate>
            <h3>2. 相手のコードを入れて比べる</h3>
            <label for="pair-partner-code">相手のコード</label>
            <div class="pair-input-row">
              <input id="pair-partner-code" name="partner" type="text" inputmode="text" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="例: AB12-CD34-EF56-GH78" aria-describedby="pair-error" />
              <button class="btn primary" type="submit">比べる</button>
            </div>
            <p id="pair-error" class="pair-error" role="alert"></p>
          </form>
          <div id="pair-result" class="pair-result" hidden aria-live="polite"></div>
        </div>
        <div class="card consult-nudge">
          <span class="eyebrow">TALK</span>
          <h2>言葉にしてみたいことがあれば</h2>
          <p class="muted">MAPはあくまで今の傾向です。誰かに話したいこと、言いづらいことがあれば、匿名相談にそのまま送ってみてください。</p>
          <a class="btn primary" href="/consult/">匿名相談へ</a>
        </div>
        <div class="notice privacy-note">この結果画面の作成に使った回答値は、このMVPではサーバーへ送信していません。アクセス解析にも個別回答・個別スコアは送信しません。</div>
      </section>
    </div>
  </section>
  <script type="application/json" id="question-data" set:html={JSON.stringify(QUESTIONS)}></script>
  <script type="application/json" id="dimension-data" set:html={JSON.stringify(DIMENSIONS)}></script>
</BaseLayout>

<script>
import { track } from '../../lib/analytics';
import { calculateScores, buildRecommendations, preferenceSummary } from '../../lib/scoring';
import { initPairUi } from '../../lib/pair-ui';
type Dimension='novelty'|'intimacy'|'initiative'|'desired'|'openness'|'satisfaction'|'boredom'|'intensity';
type Question={id:string;text:string;dimension:Dimension;reverse?:boolean};
type DimensionMeta=Record<Dimension,{label:string;short:string;kind:'preference'|'state'}>;
const QUESTIONS:Question[]=JSON.parse(document.querySelector<HTMLScriptElement>('#question-data')?.textContent||'[]');
const DIMENSIONS:DimensionMeta=JSON.parse(document.querySelector<HTMLScriptElement>('#dimension-data')?.textContent||'{}');
const pair=initPairUi(DIMENSIONS);
const intro=document.querySelector<HTMLElement>('#intro')!,start=document.querySelector<HTMLButtonElement>('#start')!,form=document.querySelector<HTMLFormElement>('#check-form')!,result=document.querySelector<HTMLElement>('#result')!;
const sections=[...document.querySelectorAll<HTMLElement>('[data-section]')],progressBar=document.querySelector<HTMLElement>('#progress-bar')!,progressLabel=document.querySelector<HTMLElement>('#progress-label')!;
const resultTitle=document.querySelector<HTMLElement>('#result-title')!,resultSummary=document.querySelector<HTMLElement>('#result-summary')!,recommendations=document.querySelector<HTMLElement>('#recommendations')!,share=document.querySelector<HTMLButtonElement>('#share')!,retry=document.querySelector<HTMLButtonElement>('#retry')!;
let current=0,started=false;
const showSection=(index:number)=>{current=index;sections.forEach((s,i)=>s.hidden=i!==index);progressBar.style.width=`${Math.round((index/sections.length)*100)}%`;progressLabel.textContent=`Part ${index+1} / ${sections.length}`;window.scrollTo({top:0,behavior:'smooth'});};
const validateSection=(section:HTMLElement)=>{const names=[...section.querySelectorAll<HTMLInputElement>('input[type="radio"]')].map(el=>el.name);const missing=[...new Set(names)].some(name=>!form.querySelector(`input[name="${name}"]:checked`));section.querySelector<HTMLElement>('.form-error')!.textContent=missing?'このPartのすべての質問に回答してください。':'';return !missing;};
start.addEventListener('click',()=>{intro.hidden=true;form.hidden=false;showSection(0);if(!started){track('diagnosis_start',{version:'mvp_01'});started=true;}});
document.querySelectorAll<HTMLButtonElement>('[data-next]').forEach(b=>b.addEventListener('click',()=>{if(validateSection(sections[current]))showSection(Math.min(current+1,sections.length-1));}));
document.querySelectorAll<HTMLButtonElement>('[data-back]').forEach(b=>b.addEventListener('click',()=>showSection(Math.max(current-1,0))));
const collectAnswers=()=>{const answers:Record<string,number>={};for(const q of QUESTIONS){const selected=form.querySelector<HTMLInputElement>(`input[name="${q.id}"]:checked`);if(selected)answers[q.id]=Number(selected.value);}return answers;};
const render=(scores:Record<Dimension,number>)=>{pair.setScores(scores);(Object.keys(scores) as Dimension[]).forEach(id=>{const row=document.querySelector<HTMLElement>(`[data-score-row="${id}"]`);if(!row)return;row.querySelector<HTMLElement>('[data-score-value]')!.textContent=String(scores[id]);row.querySelector<HTMLElement>('[data-score-fill]')!.style.width=`${scores[id]}%`;});resultTitle.textContent='今のあなたの欲求MAP';resultSummary.textContent=preferenceSummary(scores,DIMENSIONS);const articleSlugByRec:Partial<Record<string,string>>={freshness:'routine-vs-security',language:'expressing-wanting-to-be-desired',desired:'expressing-wanting-to-be-desired',checkin:'talk-about-desire-gap',conversation:'talk-about-desire-gap','low-intensity':'is-my-desire-normal',closeness:'touch-without-pressure'};recommendations.innerHTML='';buildRecommendations(scores).forEach(rec=>{const article=document.createElement('article');article.className='rec-card';const slug=articleSlugByRec[rec.id];const href=slug?`/articles/${slug}/`:'/articles/';article.innerHTML=`<h3>${rec.title}</h3><p>${rec.body}</p><a href="${href}" data-rec="${rec.id}">関連する読みものを見る →</a>`;recommendations.append(article);});recommendations.querySelectorAll<HTMLAnchorElement>('[data-rec]').forEach(a=>a.addEventListener('click',()=>track('recommendation_click',{recommendation_id:a.dataset.rec||'unknown'})));};
form.addEventListener('submit',e=>{e.preventDefault();if(!validateSection(sections[current]))return;render(calculateScores(QUESTIONS,collectAnswers()));form.hidden=true;result.hidden=false;progressBar.style.width='100%';track('diagnosis_complete',{version:'mvp_01',question_count:QUESTIONS.length});window.scrollTo({top:0,behavior:'smooth'});});
share.addEventListener('click',async()=>{const data={title:'INTIMETRY｜欲求MAPセルフチェック',text:'自分が今なにを求めているのか、欲求MAPをチェックしてみました。',url:`${location.origin}/check/`};const nav=navigator as unknown as {share?: (data:ShareData)=>Promise<void>;clipboard:Clipboard};const canNativeShare=typeof nav.share==='function';try{if(canNativeShare)await nav.share!(data);else await nav.clipboard.writeText(`${data.text} ${data.url}`);track('result_share',{method:canNativeShare?'web_share':'clipboard'});}catch{}});
retry.addEventListener('click',()=>{pair.reset();form.reset();result.hidden=true;form.hidden=false;showSection(0);});
</script>

<style>
.narrow{max-width:880px}.intro:not([hidden]){display:grid;gap:20px;position:relative;overflow:hidden;isolation:isolate}.intro .btn{justify-self:start}.intro :global(.intro-blob){z-index:-1;width:220px;height:220px;top:-70px;right:-60px}.consult-nudge:not([hidden]){display:grid;gap:12px}.consult-nudge .btn{justify-self:start}.progress{height:7px;background:var(--surface);border:1px solid var(--line);border-radius:999px;overflow:hidden;margin:0 0 8px}.progress span{display:block;height:100%;width:0;background:var(--accent);transition:width .3s ease}.progress-label{color:var(--muted);font-size:.82rem;text-align:right;margin:0 0 12px}fieldset{border:1px solid var(--line);margin:0}legend{padding:0 10px;color:var(--accent);font-weight:800}.question{padding:24px 0;border-bottom:1px solid var(--line)}.question:last-of-type{border-bottom:none}.q-number{color:var(--accent);font-size:.78rem;font-weight:900;letter-spacing:.08em}.question h2{font-size:clamp(1.05rem,3vw,1.35rem);line-height:1.45;margin:5px 0 15px}.scale{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}.scale label{cursor:pointer}.scale input{position:absolute;opacity:0;pointer-events:none}.scale span{min-height:68px;display:grid;place-items:center;gap:2px;text-align:center;border:1px solid var(--line);border-radius:12px;padding:8px 5px;color:var(--muted);background:#100d13}.scale b{color:var(--text)}.scale small{font-size:.65rem;line-height:1.2}.scale input:checked+span{border-color:var(--accent);background:#342234;color:var(--text);box-shadow:0 0 0 1px var(--accent) inset}.scale input:focus-visible+span{outline:2px solid var(--accent-2);outline-offset:2px}.step-actions,.result-actions{display:flex;justify-content:space-between;gap:10px;margin-top:24px;flex-wrap:wrap}.form-error{color:var(--danger);min-height:1.5em}.result:not([hidden]){display:grid;gap:18px}.result-hero{display:grid;gap:14px;position:relative;overflow:hidden;isolation:isolate}.result-hero :global(.result-blob){z-index:-1;width:240px;height:240px;bottom:-90px;left:-60px}.result-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.bars{display:grid;gap:18px;margin-top:24px}.recommendations{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:20px}:global(.rec-card){border:1px solid var(--line);border-radius:16px;padding:18px;background:#100d13}:global(.rec-card h3){margin:0 0 8px;font-size:1.05rem}:global(.rec-card p){color:var(--muted);font-size:.9rem}:global(.rec-card a){color:var(--accent-2);font-weight:800;font-size:.86rem;text-decoration:none}.privacy-note{margin-top:4px}.pair-card:not([hidden]){display:grid;gap:16px}.pair-step{display:grid;gap:10px}.pair-step h3{margin:0;font-size:1.05rem}.pair-code{display:block;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:clamp(1.1rem,5vw,1.6rem);font-weight:800;letter-spacing:.12em;padding:14px 16px;border:1px dashed var(--accent);border-radius:14px;background:#100d13;overflow-wrap:anywhere;user-select:all}.pair-actions{display:flex;gap:10px;flex-wrap:wrap}.pair-status,.pair-error{margin:0;min-height:1.4em;font-size:.88rem}.pair-status{color:var(--muted)}.pair-error{color:var(--danger)}.pair-step label{font-weight:700}.pair-input-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px}.pair-input-row input{width:100%;min-width:0;background:#100d13;border:1px solid var(--line);border-radius:12px;color:var(--text);padding:13px 14px;font:inherit;letter-spacing:.08em}.pair-result:not([hidden]){display:grid;gap:14px;margin-top:4px}.pair-result :global(h3){margin:0;font-size:1.2rem}.pair-result :global(h3:focus){outline:none}.pair-result :global(.pair-summary),.pair-result :global(.pair-note){margin:0;color:var(--muted)}.pair-result :global(.pair-rows){display:grid;gap:12px}.pair-result :global(.pair-row){display:grid;gap:8px;padding:16px;border:1px solid var(--line);border-radius:16px;background:#100d13}.pair-result :global(.pair-row-head){display:flex;justify-content:space-between;align-items:baseline;gap:10px;flex-wrap:wrap}.pair-result :global(.pair-label){font-weight:800}.pair-result :global(.pair-tag){font-size:.74rem;color:var(--muted);border:1px solid var(--line);border-radius:999px;padding:2px 9px}.pair-result :global(.pair-bar){display:grid;grid-template-columns:3.2em minmax(0,1fr) 2.4em;gap:10px;align-items:center}.pair-result :global(.pair-who){font-size:.82rem;color:var(--muted)}.pair-result :global(.pair-bar b){text-align:right;font-variant-numeric:tabular-nums}.pair-result :global(.pair-track){height:10px;background:#0d0b0f;border-radius:999px;overflow:hidden;border:1px solid var(--line)}.pair-result :global(.pair-fill){display:block;height:100%}.pair-result :global(.pair-fill.mine){background:linear-gradient(90deg,#9b6e8e,#efd0e4)}.pair-result :global(.pair-fill.theirs){background:linear-gradient(90deg,#6f86a8,#bcd0ea)}.pair-result :global(.pair-gap),.pair-result :global(.pair-ask){margin:0;font-size:.9rem}.pair-result :global(.pair-gap){color:var(--muted)}@media(max-width:700px){.scale{grid-template-columns:repeat(5,minmax(0,1fr));gap:4px}.scale span{min-height:64px;padding:6px 2px}.scale small{font-size:.56rem;line-height:1.05}.result-grid,.recommendations{grid-template-columns:1fr}}
</style>