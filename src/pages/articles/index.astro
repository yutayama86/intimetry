---
import BaseLayout from '../../layouts/BaseLayout.astro';
const articles=[['欲求の強さが違う二人は、何から話せばいい？','「回数」だけで話さず、何が満たされると嬉しいかを分解する考え方。'],['マンネリと安心感は、同じではない','変化を増やす前に、残したい安心感と変えたい習慣を切り分けます。'],['「求められたい」を責めずに伝える','承認や愛情確認としての欲求を、相手への要求ではなく希望に翻訳する方法。']];
---
<BaseLayout title="読みもの"><section class="section"><div class="container"><span class="eyebrow">Journal</span><h1 class="h2">自分と相手を理解する読みもの</h1><p class="lead">公開初期は、診断結果と匿名相談から必要性の高いテーマを優先して増やします。</p><div class="grid grid-3 article-grid">{articles.map(([title,description])=><article class="card"><span class="pill">準備中</span><h2>{title}</h2><p>{description}</p></article>)}</div></div></section></BaseLayout><style>.article-grid{margin-top:32px}.card h2{font-size:1.15rem}.card p{color:var(--muted)}</style>