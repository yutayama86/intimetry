---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ARTICLES, formatDateJa } from '../../../data/articles';
import { SITE } from '../../../data/site';
import PrNotice from '../../../components/PrNotice.astro';
import AffiliateCard from '../../../components/AffiliateCard.astro';

export function getStaticPaths() {
  return ARTICLES.map((article, index) => ({
    params: { slug: article.slug },
    props: { article, index },
  }));
}

const { article, index } = Astro.props;
const origin = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).origin;
const url = `${origin}/articles/${article.slug}/`;
const related = [1, 2, 3].map((offset) => ARTICLES[(index + offset) % ARTICLES.length]);
const publisher = {
  '@type': 'Organization',
  name: SITE.operator,
  url: origin,
  logo: { '@type': 'ImageObject', url: `${origin}/icon-512.png` },
};
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: article.title,
    description: article.description,
    inLanguage: 'ja',
    datePublished: article.publishedAt,
    dateModified: article.publishedAt,
    mainEntityOfPage: url,
    image: `${origin}/ogp.png`,
    author: publisher,
    publisher,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.name, item: `${origin}/` },
      { '@type': 'ListItem', position: 2, name: '読みもの', item: `${origin}/articles/` },
      { '@type': 'ListItem', position: 3, name: article.title, item: url },
    ],
  },
];
---
<BaseLayout title={article.title} description={article.description} schema={schema}>
  <section class="section"><div class="container prose">
    <nav class="breadcrumb" aria-label="パンくずリスト">
      <a href="/">ホーム</a><span aria-hidden="true">›</span><a href="/articles/">読みもの</a>
    </nav>
    {article.affiliate && <PrNotice />}
    <span class="eyebrow">Journal</span>
    <h1 class="h2">{article.title}</h1>
    <p class="lead">{article.description}</p>
    <p class="meta"><time datetime={article.publishedAt}>公開 {formatDateJa(article.publishedAt)}</time>・{SITE.operator}</p>
    {article.blocks.map((block) => {
      if (block.type === 'h2') return <h2>{block.text}</h2>;
      if (block.type === 'ul') return <ul>{block.items.map((item) => <li>{item}</li>)}</ul>;
      return <p>{block.text}</p>;
    })}
    {article.affiliate && <AffiliateCard id={article.affiliate} placement={article.slug} />}
    <p class="disclaimer">この記事は一般的な情報提供であり、医学的・心理学的な診断や治療に代わるものではありません。体調や症状に関わる場合は、医療機関にご相談ください。</p>
    <div class="notice cta-notice">
      <strong>次の一歩</strong><br />
      自分の傾向を知りたい方は<a href="/check/">欲求MAP</a>、話してみたい方は<a href="/consult/">匿名相談</a>をどうぞ。
    </div>
    <section class="related" aria-labelledby="related-title">
      <h2 id="related-title">あわせて読みたい</h2>
      <ul>
        {related.map((item) => <li><a href={`/articles/${item.slug}/`}>{item.title}</a></li>)}
      </ul>
    </section>
    <p class="back-link"><a href="/articles/">← 読みもの一覧へ</a></p>
  </div></section>
</BaseLayout>
<style>
  .breadcrumb { display: flex; gap: 8px; align-items: center; margin-bottom: 18px; font-size: .82rem; color: var(--muted); }
  .breadcrumb a { color: var(--muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--text); }
  .meta { color: var(--muted); font-size: .85rem; margin: 0 0 8px; }
  .disclaimer { margin-top: 36px; color: var(--muted); font-size: .85rem; }
  .cta-notice { margin-top: 20px; }
  .cta-notice a { color: var(--accent-2); font-weight: 800; }
  .related { margin-top: 44px; padding-top: 8px; border-top: 1px solid var(--line); }
  .related h2 { font-size: 1.1rem; margin-top: 1.2em; }
  .related ul { padding-left: 1.1em; }
  .related a { color: var(--accent-2); text-decoration: none; }
  .related a:hover { text-decoration: underline; }
  .back-link { margin-top: 24px; }
  .back-link a { color: var(--muted); text-decoration: none; font-size: .9rem; }
  .back-link a:hover { color: var(--text); }
</style>
