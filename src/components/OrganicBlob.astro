---
interface Props { class?: string; flip?: boolean }
const { class: className = '', flip = false } = Astro.props;
const uid = Math.random().toString(36).slice(2, 9);
---
<svg class:list={['organic-blob', className, { flip }]} viewBox="-100 -100 200 200" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`blob-grad-${uid}`} x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="var(--accent)" />
      <stop offset="100%" stop-color="var(--accent-2)" />
    </linearGradient>
    <filter id={`blob-blur-${uid}`} x="-40%" y="-40%" width="180%" height="180%">
      <feGaussianBlur stdDeviation="6" />
    </filter>
  </defs>
  <path
    d="M45.3,-58.8C58.5,-49.7,68.5,-34.6,72.6,-17.9C76.7,-1.3,74.9,17,66.9,31.8C58.9,46.6,44.7,57.9,29,63.6C13.3,69.3,-3.9,69.4,-20.5,64.9C-37.1,60.4,-53.1,51.3,-63.4,37.5C-73.7,23.6,-78.3,5,-74.6,-11.4C-70.9,-27.8,-58.9,-42,-44.6,-51C-30.3,-60,-15.1,-63.8,1.6,-66.1C18.4,-68.4,36.8,-69.2,45.3,-58.8Z"
    fill={`url(#blob-grad-${uid})`}
    filter={`url(#blob-blur-${uid})`}
  />
</svg>
<style>
  .organic-blob { position: absolute; pointer-events: none; z-index: 0; opacity: .45; }
  .organic-blob.flip { transform: scaleX(-1); }
  @media (prefers-contrast: more) { .organic-blob { opacity: .2; } }
</style>
