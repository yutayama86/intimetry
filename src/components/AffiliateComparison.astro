---
import AffiliateOfferLink from './AffiliateOfferLink.astro';
interface Row { label: string; value: string; }
interface Props { title: string; intro: string; verifiedAt: string; rows: Row[]; offerId?: string; }
const { title, intro, verifiedAt, rows, offerId } = Astro.props;
---
<section class="affiliate-comparison" aria-label={title}>
  <div class="affiliate-comparison__header">
    <span class="affiliate-comparison__tag">比較・選び方ガイド</span>
    <h2>{title}</h2>
    <p>{intro}</p>
    <small>最終確認日：<time datetime={verifiedAt}>{verifiedAt}</time>　掲載情報は変更される場合があります。</small>
  </div>
  <dl>
    {rows.map(({ label, value }) => (
      <div class="affiliate-comparison__row"><dt>{label}</dt><dd>{value}</dd></div>
    ))}
  </dl>
  {offerId && <AffiliateOfferLink offerId={offerId} placement="comparison-card" />}
</section>
<style>
.affiliate-comparison{margin-block:2rem;border:1px solid var(--line);border-radius:16px;overflow:hidden}
.affiliate-comparison__header{padding:1.25rem;background:var(--surface)}
.affiliate-comparison__header h2{margin:.5rem 0;font-size:clamp(1.15rem,2.5vw,1.7rem)}
.affiliate-comparison__header p{color:var(--muted)}
.affiliate-comparison__header small{color:var(--muted)}
.affiliate-comparison__tag{font-size:.75rem;letter-spacing:.04em;font-weight:800}
.affiliate-comparison dl{margin:0}
.affiliate-comparison__row{display:grid;grid-template-columns:minmax(110px,1fr) 2fr;border-top:1px solid var(--line)}
.affiliate-comparison dt,.affiliate-comparison dd{margin:0;padding:1rem;overflow-wrap:anywhere}
.affiliate-comparison dt{font-weight:700}
.affiliate-comparison :global(.affiliate-offer){margin:1.25rem}
@media(max-width:500px){.affiliate-comparison__row{grid-template-columns:1fr}.affiliate-comparison dt{padding:1rem 1rem .25rem}.affiliate-comparison dd{padding:.25rem 1rem 1rem}}
</style>
